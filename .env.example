# 민트 아크릴샵 챗봇 설정 파일
# 아래 ANTHROPIC_API_KEY= 뒤에 내 API 키를 붙여 넣고 저장하세요. (따옴표 없이)
# 이 파일은 다른 사람에게 보내거나 인터넷에 올리지 마세요.

ANTHROPIC_API_KEY=

# 사용할 AI 모델 이름. 쓸 수 없다는 오류가 나면 Anthropic 문서의 최신 모델 이름으로 바꾸세요.
ANTHROPIC_MODEL=claude-sonnet-4-5

# 접속 주소 포트 (보통 바꿀 필요 없음)
PORT=3000

# 연습용 배송이 한 단계 넘어가는 시간(분)
SHIP_STAGE_MINUTES=2
