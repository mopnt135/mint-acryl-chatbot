rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 연습용 가상 쇼핑몰 데이터 문서 하나만 누구나 읽고 쓸 수 있어요.
    // 관리자 비밀번호가 없는 공개 연습용 설정이에요. 실제 고객 정보를 넣지 마세요.
    match /shop/data {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['json', 'updatedAt'])
                   && request.resource.data.json is string
                   && request.resource.data.json.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
